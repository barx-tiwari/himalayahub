# Copy this file to .env and fill in values. Restart `npm run dev` after editing.
# Only variables prefixed with VITE_ are exposed to the browser.
# NEVER put secret keys here: anything prefixed VITE_ ends up in the public bundle.

# Currency rates endpoint returning JSON like { "rates": { "NPR": 142.1, ... } }.
# Use {base} as a placeholder for the base currency code. Keyless example:
# VITE_CURRENCY_API_URL=https://open.er-api.com/v6/latest/{base}
VITE_CURRENCY_API_URL=

# Your own backend / serverless function that talks to an AI provider.
# The AI key lives on that server, not here. Expected contract: see README.
VITE_ASTROLOGY_API_URL=

# HimalayaHub API origin. Leave EMPTY when /api is served from the same domain (Vite dev proxy / production rewrite).
# Set only if the API runs on another host, e.g. https://api.himalayahub.com
VITE_API_URL=
# Dev only: where the Vite proxy sends /api requests it doesn't handle itself (default http://localhost:4000)
API_PROXY_TARGET=

# ─────────────────────────── Live data (v2) ───────────────────────────
# Browser-side (safe to expose — no secrets):
# Where the serverless proxy lives. Default "/api" (same origin, e.g. Vercel).
VITE_LIVE_API_BASE=
# Dev only: show clearly-labelled fictional sample data instead of calling APIs.
# Ignored in production builds (npm run build), always.
VITE_DEMO_DATA=
# Optional JSON file you maintain with emergency contacts (same shape as
# src/data/emergencyContacts.js) to update numbers without redeploying.
VITE_EMERGENCY_DATA_URL=

# Server-side ONLY (Vercel/Netlify function env or .env for `npm run dev`).
# These are read by /api functions and never reach the browser. No VITE_ prefix!
# football-data.org v4 token (free tier covers PL, La Liga, Serie A, Bundesliga, Ligue 1, UCL)
FOOTBALL_DATA_API_KEY=
# CricketData.org (cricapi) key — free tier ≈100 requests/day
CRICKETDATA_API_KEY=
# NEPSE provider (no official public API exists) — see README → NEPSE
NEPSE_API_URL=
NEPSE_API_KEY=
# Comma-separated origins allowed to call /api from other domains (optional)
ALLOWED_ORIGINS=
