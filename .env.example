# ─────────────────────────────────────────────────────────────────────────────
# HimalayaHub API — copy to `.env` in the repo root and fill in. NEVER commit .env.
# Variables without the VITE_ prefix are server-side only and never reach browsers.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# SQLite database file. The path is relative to apps/api/prisma/, so this creates apps/api/prisma/dev.db.
# Production example: DATABASE_URL=file:/var/lib/himalayahub/himalayahub.db (a persistent disk, backed up)
DATABASE_URL=file:./dev.db

# Public URLs (web app origin and API origin). Production must use https.
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Extra allowed browser origins, comma-separated (e.g. a separate CMS domain)
CORS_ORIGINS=

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Number of proxies in front of the API (1 for Vercel/Render/Nginx) so rate limits see real client IPs
TRUST_PROXY=1

# Google sign-in (optional). Redirect URI to register: ${API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (optional; needs HTTPS). Return URL to register: ${API_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key; a single line with \n separators is fine
APPLE_PRIVATE_KEY=

# Mobile-app token auth (optional overrides; defaults derive from SESSION_SECRET). 32+ chars.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=60
# Keys the anonymous community aliases (32+ chars). Set in production so SESSION_SECRET can rotate alone.
COMMUNITY_ALIAS_SECRET=

# Google Places (New) server key for nearby stays/ratings. Restrict it and set a quota + budget alert.
GOOGLE_MAPS_API_KEY=

# Sign in with Apple (optional; needs HTTPS). Return URL to register: ${API_URL}/api/auth/apple/callback
# APPLE_CLIENT_ID is the Services ID (e.g. com.himalayahub.web), not the App ID.
# APPLE_PRIVATE_KEY: contents of the .p8 file; "\n" escapes are accepted on one line.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Native/mobile apps: JWT access tokens + rotating refresh tokens. JWT_SECRET is optional
# (a separate key is derived from SESSION_SECRET when blank). Browsers always use cookies.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=60

# Community pseudonyms ("Misty-Danfe-4821"). Optional; derived from SESSION_SECRET when blank.
# Set it explicitly in production so rotating SESSION_SECRET doesn't change future aliases.
COMMUNITY_ALIAS_SECRET=

# Google Maps Platform key (server-side only) for live nearby stays, ratings and reviews.
# Enable "Places API (New)", restrict the key to that API and set a daily quota.
GOOGLE_MAPS_API_KEY=

# Email (verification + password reset). In development links print to the API console.
SMTP_URL=
MAIL_FROM="HimalayaHub <no-reply@your-domain.com>"
# Email for sign-up codes: resend | brevo (API key below), or leave empty and set SMTP_URL (+ npm i nodemailer)
MAIL_PROVIDER=
MAIL_API_KEY=
# true = send real emails in development too (otherwise they print in the API console)
MAIL_SEND_IN_DEV=false

# Media storage driver: local (dev) | s3 (any S3-compatible: AWS S3, Cloudflare R2, Backblaze B2…)
STORAGE_DRIVER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Live data providers (server-side only). Leave blank to disable a provider.
NEWS_API_KEY=
WEATHER_API_KEY=
FOOTBALL_DATA_API_KEY=
CRICKETDATA_API_KEY=
CRYPTO_API_KEY=
NEPSE_API_URL=
NEPSE_API_KEY=
MARKET_API_KEY=

LOG_LEVEL=info

# ── Seed only (npm run db:seed). Remove the password after the first run. ──
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=
# true = also add clearly-labelled [DEMO] content (refused when NODE_ENV=production)
SEED_DEMO=false
# true = refresh seeded rows from code (overwrites CMS edits to those rows). Default false.
SEED_UPDATE=false
