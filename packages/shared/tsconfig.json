    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "declaration": true, "outDir": "dist", "rootDir": "src",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "esModuleInterop": true
